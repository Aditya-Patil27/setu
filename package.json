{
  "name": "setu",
  "private": true,
  "version": "0.1.0",
  "description": "Setu — A DPDP-Compliant Backend-as-a-Service Platform for India",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "docker compose up --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "console": "node scripts/console.mjs",
    "bench:lock": "tsx tests/bench/audit-lock.bench.ts",
    "bench:read": "tsx tests/bench/read-cost.bench.ts",
    "clean": "rimraf **/dist **/node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
