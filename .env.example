# ──────────────────────────────────────────────────────────
# Setu — Local Development Environment
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=setu
POSTGRES_PASSWORD=setu_dev_password
POSTGRES_DB=setu

# ── MinIO (S3-compatible Object Storage) ────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=setu_minio
MINIO_ROOT_PASSWORD=setu_minio_password

# ── NATS (Messaging) ───────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Services ────────────────────────────────────────────
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
DATA_SERVICE_PORT=3002
STORAGE_SERVICE_PORT=3003
FUNCTIONS_SERVICE_PORT=3004
CONSENT_SERVICE_PORT=3005
AUDIT_SERVICE_PORT=3006
WORKFLOW_SERVICE_PORT=3007
METERING_SERVICE_PORT=3008

# ── Auth / JWT ──────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP Provider ────────────────────────────────────────
OTP_PROVIDER=mock
# OTP_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# ── Dashboard ───────────────────────────────────────────
DASHBOARD_PORT=3100
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Node Environment ───────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
