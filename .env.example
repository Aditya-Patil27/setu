# ──────────────────────────────────────────────────────────
# Setu — Local Development Environment
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=setu
POSTGRES_PASSWORD=setu_dev_password
POSTGRES_DB=setu

# Non-superuser roles the services connect as (NOBYPASSRLS).
# Never connect a service as POSTGRES_USER — it owns the DB and ignores RLS.
POSTGRES_RUNTIME_PASSWORD=setu_runtime_password
POSTGRES_CONTROL_PASSWORD=setu_control_password

# ── MinIO (S3-compatible Object Storage) ────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=setu_minio
MINIO_ROOT_PASSWORD=setu_minio_password

# ── NATS (Messaging) ───────────────────────────────────
# Local object store. MinIO above is provisioned but not yet wired:
# the Storage service keeps bytes behind an ObjectStore interface, and an S3
# implementation slots in without changing a call site.
STORAGE_ROOT=.storage

NATS_URL=nats://localhost:4222

# ── Services ────────────────────────────────────────────
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
DATA_SERVICE_PORT=3002
STORAGE_SERVICE_PORT=3003
FUNCTIONS_SERVICE_PORT=3004
CONSENT_SERVICE_PORT=3005
AUDIT_SERVICE_PORT=3006
WORKFLOW_SERVICE_PORT=3007
METERING_SERVICE_PORT=3008
AI_SERVICE_PORT=3009

# ── Connection pooling ──────────────────────────────────
# Per-pool ceiling. Ten services open ~14 pools between them, so this
# multiplied by 14 must stay under the server's max_connections.
POSTGRES_POOL_MAX=8
POSTGRES_POOL_IDLE_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=10000

# ── Gateway ─────────────────────────────────────────────
# How long an API key verdict is reused before argon2 runs again. Also the
# window in which a revoked key still works, so keep it short.
GATEWAY_KEY_CACHE_TTL_MS=30000
GATEWAY_KEY_CACHE_MAX=1000
# How long an upstream service has to answer before the gateway 504s.
GATEWAY_UPSTREAM_TIMEOUT_MS=5000

# ── AI (M10) ────────────────────────────────────────────
# Unset, the AI service uses a deterministic local embedder and echo
# completer, so it runs with no key and no network. Set these only to
# reach a real OpenAI-compatible provider.
# SETU_EMBEDDING_URL=https://api.openai.com/v1/embeddings
# SETU_EMBEDDING_KEY=
# SETU_EMBEDDING_MODEL=text-embedding-3-small

# ── Auth / JWT ──────────────────────────────────────────
JWT_SECRET=change-me-in-production
# HMAC key the gateway signs request context with; downstream services verify it.
INTERNAL_SIGNING_SECRET=change-me-too
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP Provider ────────────────────────────────────────
OTP_PROVIDER=mock
# OTP_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# ── Dashboard ───────────────────────────────────────────
DASHBOARD_PORT=3100
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Node Environment ───────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
